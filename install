#!/usr/bin/env bash
set -euo pipefail

command -v install >/dev/null || { echo 'install command not found' >&2; exit 1; }

SCRIPT_NAME='argononeup-automatic-shutdown'
SERVICE_NAME='argononeup-automatic-shutdown.service'

SCRIPT_SOURCE="./${SCRIPT_NAME}.sh"
SERVICE_SOURCE="./${SERVICE_NAME}"

[[ -f "${SCRIPT_SOURCE}" ]] || { echo "Missing file: ${SCRIPT_SOURCE}" >&2; exit 1; }
[[ -f "${SERVICE_SOURCE}" ]] || { echo "Missing file: ${SERVICE_SOURCE}" >&2; exit 1; }

SCRIPT_DESTINATION="${HOME}/.local/bin/${SCRIPT_NAME}"
SERVICE_DESTINATION="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}"

install_file() {
    local SOURCE_FILE_PATH="${1}"
    local DESTINATION_FILE_PATH="${2}"
    local FILE_MODE="${3:-644}"

    echo "Installing '${SOURCE_FILE_PATH}' → '${DESTINATION_FILE_PATH}'..."
    mkdir -p "$(dirname "${DESTINATION_FILE_PATH}")"
    install -m "${FILE_MODE}" "${SOURCE_FILE_PATH}" "${DESTINATION_FILE_PATH}"
}

install_file "${SCRIPT_SOURCE}" "${SCRIPT_DESTINATION}" 755
install_file "${SERVICE_SOURCE}" "${SERVICE_DESTINATION}" 644

echo 'Reloading systemd...'
systemctl --user daemon-reload || {
    echo 'Failed to reload systemd user daemon' >&2
    exit 1
}

echo 'Enabling and starting the service...'
systemctl --user enable --now "${SERVICE_NAME}"

echo 'Done!'
