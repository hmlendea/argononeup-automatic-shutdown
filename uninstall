#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME='argononeup-automatic-shutdown'
SERVICE_NAME='argononeup-automatic-shutdown.service'

SCRIPT_PATH="${HOME}/.local/bin/${SCRIPT_NAME}"
SERVICE_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}"

echo 'Stopping and disabling the service (if it exists)...'
systemctl --user disable --now "${SERVICE_NAME}" 2>/dev/null || true

echo "Removing the service: ${SERVICE_PATH}"
rm -f "${SERVICE_PATH}"

echo "Removing the script: ${SCRIPT_PATH}"
rm -f "${SCRIPT_PATH}"

echo 'Reloading systemd...'
systemctl --user daemon-reload

echo 'Done!'
